# ==========================================
# Frontend Environment Variables (.env.example)
# Copy this file to .env.local for local development.
# In Vercel, add these under Project Settings -> Environment Variables.
# All variables here are strictly server-side (no NEXT_PUBLIC_ exposure).
# ==========================================

# Express Backend API Base URL (used by Server Actions & BFF API routes)
# Local: http://localhost:5000/api/v1
# Vercel Production: https://<your-railway-app>.up.railway.app/api/v1
BACKEND_URL=http://localhost:5000/api/v1

# Frontend Site Base URL (used for server-side relative fetching)
# Local: http://localhost:3000
# Vercel Production: https://<your-project>.vercel.app (or custom domain)
SITE_URL=http://localhost:3000

# Node Environment (automatically set to production on Vercel)
NODE_ENV=development
